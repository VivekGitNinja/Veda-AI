# VedaAI Backend — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.

# Environment configuration
NODE_ENV=production
PORT=5000

# MongoDB — local or Atlas connection string
MONGODB_URI=mongodb://localhost:27017/vedaai-assessment
# Alternative variable supported by Railway/some cloud hosts
MONGO_URI=mongodb://localhost:27017/vedaai-assessment

# Redis Options
# Option A: Connect via a single unified connection string (Supports TLS/rediss:// protocols)
REDIS_URL=redis://default:password@localhost:6379

# Option B: Connect via host, port, credentials parameters
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=default
# Set to true to force TLS on individual host parameters if needed
REDIS_TLS=false

# Google Gemini API Key (optional)
# If blank, the system uses the built-in mock structured academic generator
AI_API_KEY=your_gemini_api_key_here

# Frontend origin (used for CORS and WebSockets validation)
FRONTEND_URL=http://localhost:3000
