# VedaAI Backend — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.

# Server
PORT=5000

# MongoDB — local or Atlas connection string
MONGODB_URI=mongodb://localhost:27017/vedaai-assessment

# Redis — local or cloud Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Google Gemini API Key (optional)
# If blank, the system uses the built-in mock structured generator
AI_API_KEY=your_gemini_api_key_here

# Frontend origin (used for CORS)
FRONTEND_URL=http://localhost:3000
