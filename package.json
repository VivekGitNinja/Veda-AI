{
  "name": "vedaai-assessment-creator",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "build:backend": "npm run build --workspace=apps/backend",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "start:backend": "npm run start --workspace=apps/backend",
    "start:worker": "npm run start:worker --workspace=apps/backend",
    "start:worker:prod": "npm run start:worker:prod --workspace=apps/backend",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  }
}
